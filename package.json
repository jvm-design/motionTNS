{
  "name": "motion-autoya",
  "version": "1.0.0",
  "description": "Premium motion design system with Apple's motion principles for SVG animations",
  "type": "module",
  "scripts": {
    "dev": "vite --open /frame-viewer.html",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "export:presets": "node export-animation-presets.js",
    "export:presets:file": "node export-animation-presets.js > animation-presets-export.json",
    "export:animations": "node export-animations-simple.js",
    "export:all": "node export-animations-simple.js && echo '✅ Animation library exported!'"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@lottiefiles/lottie-player": "^2.0.12",
    "@react-spring/web": "^9.7.3",
    "@remotion/cli": "^4.0.457",
    "framer-motion": "^11.0.3",
    "gsap": "^3.12.5",
    "jszip": "^3.10.1",
    "lottie-react": "^2.4.0",
    "lottie-web": "^5.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.457"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "typescript": "^5.4.3",
    "vite": "^5.2.0"
  }
}
