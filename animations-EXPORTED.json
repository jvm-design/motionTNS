{
  "meta": {
    "name": "Motion Autoya Animation Presets",
    "version": "2.0.0",
    "description": "Complete animation preset library based on Apple's Motion Principles",
    "framework": "Framer Motion / React",
    "compatible": [
      "React",
      "React Native",
      "Flutter",
      "iOS",
      "Android",
      "Web"
    ]
  },
  "springs": {
    "default": {
      "type": "spring",
      "stiffness": 380,
      "damping": 30,
      "mass": 0.8,
      "description": "Balanced and natural - Apple's standard spring"
    },
    "bouncy": {
      "type": "spring",
      "stiffness": 300,
      "damping": 20,
      "mass": 0.8,
      "description": "Playful and energetic - for buttons and interactive elements"
    },
    "stiff": {
      "type": "spring",
      "stiffness": 500,
      "damping": 35,
      "mass": 0.5,
      "description": "Quick and responsive - for immediate feedback"
    },
    "gentle": {
      "type": "spring",
      "stiffness": 200,
      "damping": 30,
      "mass": 1,
      "description": "Smooth and calm - for large movements and modals"
    },
    "wobbly": {
      "type": "spring",
      "stiffness": 250,
      "damping": 15,
      "mass": 1,
      "description": "Exaggerated bounce - for playful decorative animations"
    },
    "cameraSpring": {
      "type": "spring",
      "stiffness": 340,
      "damping": 28,
      "mass": 0.7,
      "description": "Camera sync responsive spring (1.5% overshoot)",
      "bezier": [
        0.22,
        0.61,
        0.36,
        1
      ],
      "formula": "smoothstep + sin(t * π) * 0.015 * (1 - t)"
    }
  },
  "durations": {
    "instant": 0.1,
    "quick": 0.2,
    "fast": 0.3,
    "normal": 0.4,
    "slow": 0.6,
    "slower": 0.8,
    "camera": 0.7,
    "premium": 1.5
  },
  "easings": {
    "default": {
      "bezier": [
        0.4,
        0,
        0.2,
        1
      ],
      "description": "Apple's standard easing",
      "css": "cubic-bezier(0.4, 0.0, 0.2, 1.0)"
    },
    "decelerate": {
      "bezier": [
        0,
        0,
        0.2,
        1
      ],
      "description": "Smooth deceleration (ease-out)",
      "css": "cubic-bezier(0.0, 0.0, 0.2, 1.0)"
    },
    "accelerate": {
      "bezier": [
        0.4,
        0,
        1,
        1
      ],
      "description": "Smooth acceleration (ease-in)",
      "css": "cubic-bezier(0.4, 0.0, 1.0, 1.0)"
    },
    "sharp": {
      "bezier": [
        0.4,
        0,
        0.6,
        1
      ],
      "description": "Sharp movement",
      "css": "cubic-bezier(0.4, 0.0, 0.6, 1.0)"
    },
    "emphasis": {
      "bezier": [
        0.4,
        0,
        0.2,
        1
      ],
      "description": "Emphasis (ease-in-out)",
      "css": "cubic-bezier(0.4, 0.0, 0.2, 1.0)"
    },
    "easeOutQuad": {
      "bezier": [
        0.25,
        0.46,
        0.45,
        0.94
      ],
      "description": "Decisive checkmark drawing",
      "formula": "1 - (1 - t)²",
      "css": "cubic-bezier(0.25, 0.46, 0.45, 0.94)"
    }
  },
  "variants": {
    "fadeIn": {
      "initial": {
        "opacity": 0
      },
      "animate": {
        "opacity": 1
      },
      "exit": {
        "opacity": 0
      },
      "description": "Simple fade animation"
    },
    "scaleIn": {
      "initial": {
        "scale": 0.95,
        "opacity": 0
      },
      "animate": {
        "scale": 1,
        "opacity": 1
      },
      "exit": {
        "scale": 0.95,
        "opacity": 0
      },
      "description": "Scale + fade - for modals and cards"
    },
    "liquidGlass": {
      "initial": {
        "opacity": 0,
        "scale": 0.8,
        "filter": "blur(8px)"
      },
      "animate": {
        "opacity": 1,
        "scale": 1,
        "filter": "blur(0px)"
      },
      "exit": {
        "opacity": 0,
        "scale": 0.8,
        "filter": "blur(8px)"
      },
      "transition": {
        "type": "spring",
        "stiffness": 300,
        "damping": 20
      },
      "description": "Liquid glass effect - premium entrance"
    },
    "slideUp": {
      "initial": {
        "y": "100%",
        "opacity": 0
      },
      "animate": {
        "y": 0,
        "opacity": 1
      },
      "exit": {
        "y": "100%",
        "opacity": 0
      },
      "description": "Slide from bottom - sheets and drawers"
    },
    "slideDown": {
      "initial": {
        "y": "-100%",
        "opacity": 0
      },
      "animate": {
        "y": 0,
        "opacity": 1
      },
      "exit": {
        "y": "-100%",
        "opacity": 0
      },
      "description": "Slide from top - notifications"
    },
    "slideLeft": {
      "initial": {
        "x": "100%",
        "opacity": 0
      },
      "animate": {
        "x": 0,
        "opacity": 1
      },
      "exit": {
        "x": "100%",
        "opacity": 0
      },
      "description": "Slide from right - sidebars"
    },
    "slideRight": {
      "initial": {
        "x": "-100%",
        "opacity": 0
      },
      "animate": {
        "x": 0,
        "opacity": 1
      },
      "exit": {
        "x": "-100%",
        "opacity": 0
      },
      "description": "Slide from left"
    },
    "expand": {
      "initial": {
        "scaleY": 0,
        "opacity": 0
      },
      "animate": {
        "scaleY": 1,
        "opacity": 1
      },
      "exit": {
        "scaleY": 0,
        "opacity": 0
      },
      "description": "Vertical expand/collapse"
    },
    "blurIn": {
      "initial": {
        "opacity": 0,
        "backdropFilter": "blur(0px)"
      },
      "animate": {
        "opacity": 1,
        "backdropFilter": "blur(12px)"
      },
      "exit": {
        "opacity": 0,
        "backdropFilter": "blur(0px)"
      },
      "description": "Blur fade - for backdrops and overlays"
    }
  },
  "interactionStates": {
    "subtleHover": {
      "whileHover": {
        "scale": 1.02
      },
      "whileTap": {
        "scale": 0.98
      },
      "transition": {
        "type": "spring",
        "stiffness": 500,
        "damping": 35,
        "mass": 0.5
      },
      "description": "Subtle hover for most UI elements"
    },
    "buttonHover": {
      "whileHover": {
        "scale": 1.05,
        "y": -2
      },
      "whileTap": {
        "scale": 0.95
      },
      "transition": {
        "type": "spring",
        "stiffness": 300,
        "damping": 20,
        "mass": 0.8
      },
      "description": "Button hover - more pronounced"
    },
    "iconHover": {
      "whileHover": {
        "scale": 1.1,
        "rotate": 5
      },
      "whileTap": {
        "scale": 0.9
      },
      "transition": {
        "type": "spring",
        "stiffness": 500,
        "damping": 35,
        "mass": 0.5
      },
      "description": "Icon hover with rotation"
    },
    "cardHover": {
      "whileHover": {
        "y": -8,
        "scale": 1.02
      },
      "whileTap": {
        "scale": 0.98
      },
      "transition": {
        "type": "spring",
        "stiffness": 380,
        "damping": 30,
        "mass": 0.8
      },
      "description": "Card hover - lift effect"
    }
  },
  "stagger": {
    "fast": {
      "staggerChildren": 0.03,
      "delayChildren": 0,
      "description": "Fast stagger for quick reveals"
    },
    "normal": {
      "staggerChildren": 0.05,
      "delayChildren": 0,
      "description": "Standard stagger timing"
    },
    "slow": {
      "staggerChildren": 0.1,
      "delayChildren": 0,
      "description": "Slow stagger for emphasis"
    },
    "withDelay": {
      "staggerChildren": 0.05,
      "delayChildren": 0.2,
      "description": "Stagger with initial delay"
    },
    "convergence": {
      "staggerChildren": 0.02,
      "delayChildren": 0,
      "description": "Camera convergence stagger pattern"
    }
  },
  "svgDraw": {
    "fast": {
      "duration": 1,
      "ease": [
        0,
        0,
        0.2,
        1
      ],
      "description": "Fast SVG path drawing"
    },
    "normal": {
      "duration": 1.5,
      "ease": [
        0,
        0,
        0.2,
        1
      ],
      "description": "Standard SVG path drawing"
    },
    "slow": {
      "duration": 2.5,
      "ease": [
        0,
        0,
        0.2,
        1
      ],
      "description": "Slow SVG path drawing for emphasis"
    },
    "checkmark": {
      "duration": 0.35,
      "ease": [
        0.25,
        0.46,
        0.45,
        0.94
      ],
      "description": "Decisive checkmark drawing"
    }
  },
  "logoPathDraw": {
    "pathLength": {
      "from": 0,
      "to": 1
    },
    "duration": 2,
    "ease": "easeInOut",
    "description": "Logo path reveal animation"
  },
  "gsapConfig": {
    "morphDefault": {
      "duration": 0.8,
      "ease": "power2.inOut",
      "description": "Default SVG morphing"
    },
    "morphSmooth": {
      "duration": 1.2,
      "ease": "power1.inOut",
      "description": "Smooth SVG morphing"
    },
    "morphSnappy": {
      "duration": 0.5,
      "ease": "back.out(1.2)",
      "description": "Snappy SVG morphing with overshoot"
    }
  },
  "cameraSuccess": {
    "meta": {
      "name": "Camera Success Animation",
      "duration": 700,
      "fps": 60,
      "totalFrames": 42,
      "syncPoint": {
        "frame": 18,
        "time": 300,
        "description": "Camera shutter sound ends - shapes fully merged"
      }
    },
    "timeline": {
      "recognition": {
        "frameRange": [
          0,
          11
        ],
        "timeRange": [
          0,
          183
        ],
        "duration": 183,
        "description": "Logo visible, no motion - PRIMARY cognitive recognition time"
      },
      "convergence": {
        "frameRange": [
          11,
          18
        ],
        "timeRange": [
          183,
          300
        ],
        "duration": 117,
        "description": "All 8 outer shapes converge to center - fast responsive action",
        "animation": {
          "stagger": 0.02,
          "easing": "cameraSpring",
          "scaleStart": 0.55,
          "opacityFade": 0.75,
          "filter": {
            "active": "frame 16-18 only",
            "blur": "1.4px",
            "type": "shutterBlend"
          }
        }
      },
      "beat": {
        "frameRange": [
          18,
          21
        ],
        "timeRange": [
          300,
          350
        ],
        "duration": 50,
        "description": "White circle holds (micro-pause for clarity)"
      },
      "green": {
        "frameRange": [
          21,
          32
        ],
        "timeRange": [
          350,
          533
        ],
        "duration": 183,
        "description": "White to green transformation with pulse",
        "animation": {
          "colorTransition": {
            "from": "#FFFFFF",
            "to": {
              "type": "radial",
              "cx": "38%",
              "cy": "38%",
              "stops": [
                {
                  "offset": "0%",
                  "color": "#86EFAC"
                },
                {
                  "offset": "45%",
                  "color": "#34D399"
                },
                {
                  "offset": "100%",
                  "color": "#059669"
                }
              ]
            }
          },
          "pulse": {
            "maxScale": 1.1,
            "peakAt": 0.35,
            "easing": "ease-in-out"
          }
        }
      },
      "checkmark": {
        "frameRange": [
          32,
          42
        ],
        "timeRange": [
          533,
          700
        ],
        "duration": 167,
        "description": "Checkmark draws on green circle",
        "animation": {
          "path": "M 26.5 30.5 L 28.5 32.8 L 32 28.5",
          "stroke": "#FFFFFF",
          "strokeWidth": 1.8,
          "strokeLinecap": "round",
          "strokeLinejoin": "round",
          "drawFrom": 0,
          "drawTo": 100,
          "easing": "ease-out-quad"
        }
      }
    }
  },
